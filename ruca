 local eff=impact+(should and bounce or 0)
 local sx=b.vx-C.R*b.wy
 local sy=b.vy+C.R*b.wx
 local ss=math.sqrt(sx*sx+sy*sy)
 if C.SlideEpsilon<ss then
  local fi=math.min(ss/3.5,(fric or C.SlateFriction)*eff)
  local dx,dy=sx/ss,sy/ss
  b.vx=b.vx-fi*dx b.vy=b.vy-fi*dy
  b.wx=b.wx-fi*2.5*dy/C.R b.wy=b.wy+fi*2.5*dx/C.R
 end
 if should then b.vz=bounce end
 return should
end

local function segmentTOI(x,y,vx,vy,r,s,maxT)
 local nv=vx*s.nx+vy*s.ny
 if nv>=0 then return nil end
 local d=(x-s.ax)*s.nx+(y-s.ay)*s.ny
 if d<0 then return nil end
 local t
 if d<=r then t=0 else t=(d-r)/-nv end
 if maxT<t then return nil end
 local cx=x+vx*t-r*s.nx
 local cy=y+vy*t-r*s.ny
 local sx,sy=s.bx-s.ax,s.by-s.ay
 local p=((cx-s.ax)*sx+(cy-s.ay)*sy)/(sx*sx+sy*sy)
 if p>=0 and p<=1 then return t end
 return nil
end
local function pointTOI(x,y,vx,vy,ra,px,py,rb,maxT)
 local ox,oy=x-px,y-py
 local vd=(ox*vx+oy*vy)*2
 if vd>=0 then return nil,0,0 end
 local vs=vx*vx+vy*vy
 if vs<=0 then return nil,0,0 end
 local cr=ra+rb
 local ds=ox*ox+oy*oy-cr*cr
 local t
 if ds<=0 then t=0 else
  local disc=vd*vd-vs*4*ds
  if disc<0 then return nil,0,0 end
  t=(-vd-math.sqrt(disc))/(vs*2)
 end
 if maxT<t then return nil,0,0 end
 local nx,ny=x+vx*t-px,y+vy*t-py
 local nl=math.sqrt(nx*nx+ny*ny)
 if nl<1e-12 then return nil,0,0 end
 return t,nx/nl,ny/nl
end
