end

local function simulate(input,power,doYield)
 local balls,recs,byId={},{},{}
 local cue=nil
 for i,s in ipairs(input.balls) do
  local b=newBall(s.id,s.x,s.y)
  balls[i]=b
  if b.id==0 then cue=b end
 end
 if not cue then return nil end
 local state={time=0,geometry=GEO,balls=balls}
 strike(cue,{angle=input.angle,power=power,spin=input.spin,elevation=input.elevation})
 for i,b in ipairs(balls) do recs[i]={L={x=b.x,y=b.y},P={x=b.x,y=b.y},paths={},moved=false} end
 local contacted=false
 local maxSteps=math.floor(C.MaxShotSeconds/C.FixedStep)
 local steps,capped=0,false
 local sliceStart=doYield and tick() or 0
 while true do
  if isAtRest(state) then break end
  if steps>=maxSteps then capped=true break end
  advance(state,C.FixedStep,nil,true)
  steps=steps+1
  if state.first and not contacted then
   contacted=true
   for i,b in ipairs(balls) do
    if b==cue then
     local r=recs[i]
     local c=state.contact
     r.paths[#r.paths+1]={a=r.L,b={x=c.x,y=c.y},afterContact=false}
     r.L={x=c.x,y=c.y} r.P={x=c.x,y=c.y} r.moved=true
    end
   end
  end
  for i,b in ipairs(balls) do
   local r=recs[i]
   local cx,cy=b.x,b.y
   local mx,my=cx-r.P.x,cy-r.P.y
   local m2=mx*mx+my*my
   if m2>1e-10 then
    r.moved=true
    local lx,ly=r.P.x-r.L.x,r.P.y-r.L.y
    local l2=lx*lx+ly*ly
    if l2>0.0025 then
     local cr=lx*my-ly*mx
     local dt=lx*mx+ly*my
     if dt<=0 or math.abs(cr)>0.02*math.sqrt(l2*m2) then
      r.paths[#r.paths+1]={a=r.L,b={x=r.P.x,y=r.P.y},afterContact=state.first~=nil}
      r.L={x=r.P.x,y=r.P.y}
     end
    end
    r.P={x=cx,y=cy}
   end
  end
  if doYield and steps%8==0 and tick()-sliceStart>SIM_SLICE then
   task.wait()
   sliceStart=tick()
   if not H.Running or not H.CurrentInput or H.CurrentInput.ballsKey~=input.ballsKey then return nil end
  end
 end
 local out={balls={},byId={},settled=not capped,firstContact=state.first,contact=state.contact,steps=steps,duration=state.time}
 for i,b in ipairs(balls) do
  local r=recs[i]
  local dx,dy=r.P.x-r.L.x,r.P.y-r.L.y
  if dx*dx+dy*dy>0.0004 then r.paths[#r.paths+1]={a=r.L,b={x=r.P.x,y=r.P.y},afterContact=state.first~=nil} end
  local o={id=b.id,p={x=b.x,y=b.y},r=C.R,pocketed=b.pocketed,offTable=b.offTable,moved=r.moved,paths=r.paths}
  out.balls[#out.balls+1]=o
  out.byId[b.id]=o
 end
 return out
end
