local function anchorSpeed(p)
 local a=C.PowerAnchors
 if p<=a[1][1] then return a[1][2] end
 for i=2,#a do
  local c=a[i]
  if p<=c[1] then local q=a[i-1] return q[2]*(c[2]/q[2])^((p-q[1])/(c[1]-q[1])) end
 end
 return a[#a][2]
end
local function powerShare(p)
