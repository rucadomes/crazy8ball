  local ox,oy=x-p.x,y-p.y
  local d=math.sqrt(ox*ox+oy*oy)
  if d<=p.radius then return p end
  if d<nd then nd=d np=p end
 end
 if not containsCenter(g,x,y,SHELF_DISTANCE) then return np end
