end

local function clampSpin(sx,sy)
 local m=C.MaxSpinOffset
 local l=math.max(math.abs(sx),math.abs(sy))
 if l==0 then return 0,0 end
 local nx,ny=sx/l,sy/l
 local nm=math.sqrt(nx*nx+ny*ny)
 if m/nm<l then return nx/nm*m,ny/nm*m end
 return sx,sy
end
local function stickSpeedForPower(power,elev)
 local ef=clamp(((elev or C.CueElevation)-C.CueElevation)/(C.JumpCap-C.CueElevation),0,1)
 local mx=C.MaxStickSpeed+(C.JumpMaxStickSpeed-C.MaxStickSpeed)*ef
 return C.MinStickSpeed+(mx-C.MinStickSpeed)*powerShare(power)
end
local function strike(b,shot)
 local R=C.R
 local sx,sy=0,0
 if shot.spin then sx,sy=clampSpin(shot.spin.x,shot.spin.y) end
 local elev=math.rad(clamp(shot.elevation or C.CueElevation,0,C.MaxElevation))
 local ec,es=math.cos(elev),math.sin(elev)
 local rem=math.sqrt(1-sx*sx-sy*sy)
 local eff=math.min(elev,math.rad(C.CueElevation))
 local vspin=sy*ec-rem*math.sin(eff)
 local m=MASS_RATIO
 local impactFactor=1+m+(sx*sx+vspin*vspin)*2.5
 local e=C.TipRestitution
 local energy=1-(1-((1-m*e)^2+m*(1+e)^2)/(1+m)^2)/m*impactFactor
 local impact=stickSpeedForPower(shot.power,math.deg(elev))*(math.sqrt(math.max(0,energy))+1)/impactFactor
 local hs=impact*ec
 local dx,dy=math.cos(shot.angle),math.sin(shot.angle)
 b.vx=dx*hs b.vy=dy*hs b.vz=0 b.z=0
 local sf=2.5*impact/R
 local top=sf*vspin
 b.wx=-dy*top
 b.wy=dx*top
 b.wz=sf*sx*ec
 local jf=clamp((math.deg(elev)-C.CueElevation)/(C.JumpCap-C.CueElevation),0,1)
 local sr=C.SlateRestitution*(C.FlatStrikeBounce+(1-C.FlatStrikeBounce)*jf)
 slate(b,impact*es,false,sr,C.SlateFriction*jf)
 return hs
end

local function ballFriction(speed)
 local t=C.BallFrictionTable
 if speed<=t[1][1] then return t[1][2] end
 for i=2,#t do
  local c=t[i]
  if speed<=c[1] then local p=t[i-1] return p[2]+(speed-p[1])/(c[1]-p[1])*(c[2]-p[2]) end
 end
 return t[#t][2]
end
local function frictionImpulse(vx,vy,sx,sy,sz,nx,ny,imp)
 local R=C.R
 local slx=-vx*ny+vy*nx+R*sz
 local sly=R*(sx*ny-sy*nx)
 local ss=math.sqrt(slx*slx+sly*sly)
 if ss>C.BallSlipEpsilon then
  local f=math.min(ballFriction(ss)*imp,ss/7)
  return -f*slx/ss,-f*sly/ss
 end
 return 0,0
end
local contactStiffness,restitutionDamping=0,0
local function groupEnergy(balls)
 local e=0
 for _,b in ipairs(balls) do e=e+kinetic(b,C.R) end
 return e
end
local function resolveContacts(balls,ballA,ballB)
 local R=C.R
 local n=#balls
 local step=C.SoftContactStep
 local half=step*0.5
 local maxSteps=math.max(1,math.floor(C.SoftContactMaxSeconds/step+0.5))
 local skin=C.SoftContactSkinInches
 local dia=R*2
 local dia2=dia*dia
 local cd=dia+skin
 local cd2=cd*cd
 local k,damp=contactStiffness,restitutionDamping
 local px,py,vx,vy,sx,sy,sz={},{},{},{},{},{},{}
 for i,b in ipairs(balls) do px[i]=b.x py[i]=b.y vx[i]=b.vx vy[i]=b.vy sx[i]=b.wx sy[i]=b.wy sz[i]=b.wz end
 local e0=groupEnergy(balls)
 local total=math.sqrt(e0*2)
 local rebuild
 if total>0 then rebuild=math.max(1,math.floor(skin/(total*2*step))) else rebuild=maxSteps end
 local pf,ps,acc,cnx,cny={},{},{},{},{}
 local dvx,dvy={},{}
 for i=1,n do dvx[i]=0 dvy[i]=0 end
 local count,stepIndex,counter,had=0,0,0,false
 local function rebuildPairs()
  count=0
  for i=1,n do
   local fx,fy=px[i],py[i]
   for j=i+1,n do
    local dx,dy=px[j]-fx,py[j]-fy
    if dx*dx+dy*dy<cd2 then count=count+1 pf[count]=i ps[count]=j acc[count]=0 end
   end
  end
 end
 rebuildPairs()
 while true do
  for i=1,n do dvx[i]=0 dvy[i]=0 end
  local active=count
  local hits=0
  for c=1,active do
   local i,j=pf[c],ps[c]
   local dx,dy=px[j]-px[i],py[j]-py[i]
   local d2=dx*dx+dy*dy
   if d2<dia2 then
    hits=hits+1
    local d=math.sqrt(d2)
    local nx,ny=dx/d,dy/d
    local ov=dia-d
    local orr=math.sqrt(ov)
    local rv=(vx[i]-vx[j])*nx+(vy[i]-vy[j])*ny
    local imp=k*ov*orr+damp*math.sqrt(orr)*rv
    if imp<0 then imp=0 end
    acc[c]=imp cnx[c]=nx cny[c]=ny
    dvx[i]=dvx[i]-imp*nx dvy[i]=dvy[i]-imp*ny
    dvx[j]=dvx[j]+imp*nx dvy[j]=dvy[j]+imp*ny
   else acc[c]=0 end
  end
  if stepIndex>0 then
   for i=1,n do vx[i]=vx[i]+half*dvx[i] vy[i]=vy[i]+half*dvy[i] end
   if hits==0 then
    if had then break end
   else
    had=true
    for c=1,active do
     local imp=acc[c]
     if imp>0 then
      local i,j=pf[c],ps[c]
      local nx,ny=cnx[c],cny[c]
      local fx,fy=frictionImpulse(vx[i]-vx[j],vy[i]-vy[j],sx[i]+sx[j],sy[i]+sy[j],sz[i]+sz[j],nx,ny,imp*step)
      if fx~=0 or fy~=0 then
       local ux,uy=-ny*fx,nx*fx
       vx[i]=vx[i]+ux vy[i]=vy[i]+uy vx[j]=vx[j]-ux vy[j]=vy[j]-uy
       local wx=ny*2.5*fy/R
       local wy=nx*-2.5*fy/R
       local wz=2.5*fx/R
       sx[i]=sx[i]+wx sy[i]=sy[i]+wy sz[i]=sz[i]+wz
       sx[j]=sx[j]+wx sy[j]=sy[j]+wy sz[j]=sz[j]+wz
      end
     end
    end
   end
  end
  if maxSteps<=stepIndex then break end
  stepIndex=stepIndex+1
  for i=1,n do
   local nvx=vx[i]+half*dvx[i]
   local nvy=vy[i]+half*dvy[i]
   vx[i]=nvx vy[i]=nvy
   px[i]=px[i]+step*nvx py[i]=py[i]+step*nvy
  end
  counter=counter+1
  if rebuild<=counter then counter=0 rebuildPairs() end
 end
 for i,b in ipairs(balls) do b.x=px[i] b.y=py[i] b.vx=vx[i] b.vy=vy[i] b.wx=sx[i] b.wy=sy[i] b.wz=sz[i] end
 for _=1,4 do
  local ok=true
  for i=1,n do
   local a=balls[i]
   for j=i+1,n do
    local b=balls[j]
    local dx,dy=b.x-a.x,b.y-a.y
    local d=math.sqrt(dx*dx+dy*dy)
    local md=dia+C.ContactSlop
    if d<md and d>1e-12 then
     local corr=(md-d)/2
     a.x=a.x-dx/d*corr a.y=a.y-dy/d*corr
     b.x=b.x+dx/d*corr b.y=b.y+dy/d*corr
     ok=false
    end
   end
  end
  if ok then break end
 end
 local e1=groupEnergy(balls)
 if e0<e1 then
  local ax,ay=0,0
  for _,b in ipairs(balls) do ax=ax+b.vx ay=ay+b.vy end
  ax=ax/n ay=ay/n
  local rel=0
  for _,b in ipairs(balls) do local rx,ry=b.vx-ax,b.vy-ay rel=rel+0.5*(rx*rx+ry*ry) end
  local ex=e1-e0
  local sc=0
  if ex<rel then sc=math.sqrt((rel-ex)/rel) end
  for _,b in ipairs(balls) do b.vx=ax+(b.vx-ax)*sc b.vy=ay+(b.vy-ay)*sc end
 end
 return stepIndex*step
end
do
 local cdur=C.BallContactMicroseconds*1e-6/2.9432
 contactStiffness=math.sqrt(0.25/(C.BallContactReferenceSpeed*cdur*cdur*cdur*cdur*cdur))
 local ref=C.BallContactReferenceSpeed
 local function rest(d)
  restitutionDamping=d
  local a=newBall(0,0,0)
  local b=newBall(1,2*C.R,0)
  a.vx=ref
  resolveContacts({a,b},a,b)
  return (b.vx-a.vx)/ref
 end
 local target=C.BallRestitution
 if rest(0)<=target then restitutionDamping=0 else
  local lo,hi=0,math.sqrt(contactStiffness)
  while target<rest(hi) do lo=hi hi=hi*2 end
  for _=1,48 do
   local mid=(lo+hi)/2
   if target<rest(mid) then lo=mid else hi=mid end
  end
  restitutionDamping=(lo+hi)/2
 end
end
local function clusterTouches(balls,a,b,ex)
 local md=2*C.R+C.ClusterGapInches
 local md2=md*md
 for _,x in ipairs(balls) do
  if x~=a and x~=b and not x.pocketed and not (ex and ex[x]) then
   local ax,ay=x.x-a.x,x.y-a.y
   local bx,by=x.x-b.x,x.y-b.y
   if ax*ax+ay*ay<=md2 or bx*bx+by*by<=md2 then return true end
  end
 end
 return false
end
local function clusterGather(balls,a,b,g,ex,ignoredBall)
 local R=C.R
 local mct=C.SoftContactMaxSeconds
 local inc={[a]=true,[b]=true}
 local cl={a,b}
 local energy=kinetic(a,R)+kinetic(b,R)
 local expanded=true
 while expanded do
  local ss=math.sqrt(2*energy)
  expanded=false
  for _,x in ipairs(balls) do
   if not (inc[x] or x.pocketed or (ex and ex[x])) then
    local sr=2*R+math.max(C.ClusterGapInches,(ss+ballSpeed(x))*mct)
    for _,c in ipairs(cl) do
     local dx,dy=x.x-c.x,x.y-c.y
     if dx*dx+dy*dy<=sr*sr then
      inc[x]=true cl[#cl+1]=x energy=energy+kinetic(x,R) expanded=true
      break
     end
    end
   end
  end
 end
 for _,x in ipairs(cl) do if x~=ignoredBall and isAirborne(x) then return nil end end
 local margin=math.max(R,C.CornerPocketRadius,C.SidePocketRadius)+math.sqrt(2*energy)*mct
 for _,x in ipairs(cl) do
  if math.abs(x.x)+margin>=g.halfLength or math.abs(x.y)+margin>=g.halfWidth then return nil end
 end
 local out={}
 for _,x in ipairs(balls) do if inc[x] then out[#out+1]=x end end
 return out
end

local function integrateFalling(b,dt,p)
 b.vz=b.vz-C.Gravity*dt
 b.z=b.z+b.vz*dt
 if p then
  local ox,oy=b.x-p.x,b.y-p.y
  local d=math.sqrt(ox*ox+oy*oy)
  if d>1e-6 then
   b.vx=b.vx-ox/d*C.PocketFunnelAccel*dt
   b.vy=b.vy-oy/d*C.PocketFunnelAccel*dt
  end
 end
 local drag=math.max(0,1-C.PocketDragPerSecond*dt)
 b.vx=b.vx*drag b.vy=b.vy*drag
 b.x=b.x+b.vx*dt b.y=b.y+b.vy*dt
 if p then
  local ox,oy=b.x-p.x,b.y-p.y
  local d=math.sqrt(ox*ox+oy*oy)
  local wr=math.max(p.radius-C.R,0)
  if wr<d and d>1e-6 then
   local dx,dy=ox/d,oy/d
   b.x=p.x+dx*wr b.y=p.y+dy*wr
   local out=b.vx*dx+b.vy*dy
   if out>0 then
    b.vx=b.vx-(1+C.PocketWallRestitution)*out*dx
    b.vy=b.vy-(1+C.PocketWallRestitution)*out*dy
   end
  end
 end
 if b.z>-C.PocketDropDepth then return end
 b.z=-C.PocketDropDepth
 stopBall(b)
 b.falling=false
 b.tip=nil
end
local function integrateTip(b,dt,p)
 local t=b.tip
 if not t then return end
 local R,g=C.R,C.Gravity
 t.px=t.px+b.vx*dt t.py=t.py+b.vy*dt
 t.omega=t.omega+5*g/(7*R)*math.sin(t.theta)*dt
 t.theta=t.theta+t.omega*dt
 local s,c=math.sin(t.theta),math.cos(t.theta)
 b.x=t.px+R*s*t.nx b.y=t.py+R*s*t.ny b.z=R*(c-1)
 b.wx=-t.ny*t.omega b.wy=t.nx*t.omega
 if R*t.omega*t.omega<g*c and t.theta<math.pi/2 then return end
 local as=R*t.omega
 b.vx=b.vx+t.nx*as*c b.vy=b.vy+t.ny*as*c b.vz=-as*s
 b.tip=nil
 if p then b.pocket=p.id end
end
local function leaveTable(b)
 b.pocketed=true b.offTable=true b.falling=false b.pocket=nil b.tip=nil
end
local integrateBall
integrateBall=function(b,dt,g)
 if b.pocketed then
  local p=b.pocket and g.pockets[b.pocket] or nil
  if b.tip then integrateTip(b,dt,p) elseif b.falling then integrateFalling(b,dt,p) end
 elseif b.z<=0 and b.vz<=0 then
  local R,grav=C.R,C.Gravity
  local sf,rf=C.SlidingFriction,C.RollingFriction
  local slx=b.vx-R*b.wy
  local sly=b.vy+R*b.wx
  local ss=math.sqrt(slx*slx+sly*sly)
  local remaining
  if C.SlideEpsilon<ss then
   local dx,dy=slx/ss,sly/ss
   local st
   if sf>0 then st=ss/(3.5*sf*grav) else st=INF end
   local tt=math.min(st,dt)
   local ac=-sf*grav
   local aa=2.5*sf*grav/R
   b.x=b.x+b.vx*tt+0.5*ac*dx*tt*tt
   b.y=b.y+b.vy*tt+0.5*ac*dy*tt*tt
   b.vx=b.vx+ac*dx*tt b.vy=b.vy+ac*dy*tt
   b.wx=b.wx-aa*dy*tt b.wy=b.wy+aa*dx*tt
   remaining=dt-tt
   if st<=dt then b.wx=-b.vy/R b.wy=b.vx/R end
  else remaining=dt end
  if remaining>0 then
   local sp=math.sqrt(b.vx*b.vx+b.vy*b.vy)
   if sp>0 then
    local de=rf*grav
    local stop
    if de>0 then stop=sp/de else stop=INF end
    local tt=math.min(stop,remaining)
    local dx,dy=b.vx/sp,b.vy/sp
    b.x=b.x+b.vx*tt-0.5*de*dx*tt*tt
    b.y=b.y+b.vy*tt-0.5*de*dy*tt*tt
    if stop<=remaining then b.vx=0 b.vy=0 else b.vx=b.vx-de*dx*tt b.vy=b.vy-de*dy*tt end
   end
   b.wx=-b.vy/R b.wy=b.vx/R
  end
  if b.wz~=0 then b.wz=b.wz-sign(b.wz)*math.min(math.abs(b.wz),C.SideSpinDecel*dt) end
  local sp=math.sqrt(b.vx*b.vx+b.vy*b.vy)
  local ax=b.vx-R*b.wy
  local ay=b.vy+R*b.wx
  if sp<C.RestSpeed and math.sqrt(ax*ax+ay*ay)<C.SlideEpsilon then b.vx=0 b.vy=0 b.wx=0 b.wy=0 end
 else
  local ft=fly(b,dt)
  if ft<dt then
   if not openingAt(g,b.x,b.y) then
    if containsCenter(g,b.x,b.y,C.R) then
     slate(b,-b.vz,true)
     integrateBall(b,dt-ft,g)
    else leaveTable(b) end
   end
  end
 end
end
local function railRestitution(speed)
 local t=C.RailBySpeed
 if speed<=t[1][1] then return t[1][2] end
 for i=2,#t do
  local u=t[i]
  if speed<=u[1] then local l=t[i-1] return l[2]+(speed-l[1])/(u[1]-l[1])*(u[2]-l[2]) end
 end
 return t[#t][2]
end
local function resolveRail(b,nx,ny,rest,fric)
 local R=C.R
 local nh=C.CushionNose/R-1
 local nz=math.sqrt(1-nh*nh)
 local tx=-ny
 local ns=b.vx*nx+b.vy*ny
 if ns>=0 then return 0 end
 local ts=b.vx*tx+b.vy*nx
 local nsp=b.wx*nx+b.wy*ny
 local tsp=b.wx*tx+b.wy*nx
 local side=b.wz
 local impact=-ns
 local ti=ts-R*(nz*side+nh*nsp)
 local ni=nh*ns+R*tsp
 local slip=math.sqrt(ti*ti+ni*ni)
 local mfi=(rest+1)*nz*impact
 local ix,iy=0,0
 if slip>0 then
  local fi=math.min(slip/3.5,fric*mfi)
  iy=-fi*ti/slip
  ix=-fi*ni/slip
 end
 local nns=ns+(mfi*nz+ix*nh)
 local nts=ts+iy
 local nnsp=nsp-2.5*nh*iy/R
 local ntsp=tsp+ix*2.5/R
 local nside=side-nz*2.5*iy/R
 local rn=math.abs(nns)
 b.vx=rn*nx+nts*tx b.vy=rn*ny+nts*nx
 b.wx=nnsp*nx+ntsp*tx b.wy=nnsp*ny+ntsp*nx
 b.wz=nside
 return impact
end
local function resolveBalls3D(a,b,rest)
 local R=C.R
 rest=rest or C.BallRestitution
 local aG=not isAirborne(a)
 local bG=not isAirborne(b)
 local ox,oy,oz=b.x-a.x,b.y-a.y,b.z-a.z
 local d=math.sqrt(ox*ox+oy*oy+oz*oz)
 if d<1e-12 then return 0 end
 local nx,ny,nz=ox/d,oy/d,oz/d
 local rn=(a.vx-b.vx)*nx+(a.vy-b.vy)*ny+(a.vz-b.vz)*nz
 if rn<=0 then return 0 end
 local g=C.Gravity
 local perch=nil
 local psx,psy=0,0
 local total=kinetic(a,R,g)+kinetic(b,R,g)
 local er
 if math.abs(nz)>0.5 and rn<C.PerchSpeed then
  local vd=nz<0 and -1 or 1
  if nz<0 then perch=a else perch=b end
  local sx,sy=vd*nx,vd*ny
  local sl=math.sqrt(sx*sx+sy*sy)
  if sl<1e-6 then sx=1 sy=0 sl=1 end
  psx=sx/sl*C.PerchSlideSpeed psy=sy/sl*C.PerchSlideSpeed
  er=0
 else er=rest end
 local ni=(1+er)*rn/2
 a.vx=a.vx-ni*nx a.vy=a.vy-ni*ny a.vz=a.vz-ni*nz
 b.vx=b.vx+ni*nx b.vy=b.vy+ni*ny b.vz=b.vz+ni*nz
 local sx,sy,sz=a.wx+b.wx,a.wy+b.wy,a.wz+b.wz
 local slx=a.vx-b.vx+R*(sy*nz-sz*ny)
 local sly=a.vy-b.vy+R*(sz*nx-sx*nz)
 local slz=a.vz-b.vz+R*(sx*ny-sy*nx)
 local nsl=slx*nx+sly*ny+slz*nz
 local tx,ty,tz=slx-nsl*nx,sly-nsl*ny,slz-nsl*nz
 local ts=math.sqrt(tx*tx+ty*ty+tz*tz)
 if C.BallSlipEpsilon<ts then
  local fi=math.min(ballFriction(ts)*ni,ts/7)
  local dx,dy,dz=tx/ts,ty/ts,tz/ts
  a.vx=a.vx-fi*dx a.vy=a.vy-fi*dy a.vz=a.vz-fi*dz
  b.vx=b.vx+fi*dx b.vy=b.vy+fi*dy b.vz=b.vz+fi*dz
  local si=fi*-2.5/R
  local wx=si*(ny*dz-nz*dy)
  local wy=si*(nz*dx-nx*dz)
  local wz=si*(nx*dy-ny*dx)
  a.wx=a.wx+wx a.wy=a.wy+wy a.wz=a.wz+wz
  b.wx=b.wx+wx b.wy=b.wy+wy b.wz=b.wz+wz
 end
 if aG then a.vz=0 end
 if bG then b.vz=0 end
 if not perch then return rn end
 local ivx,ivy=perch.vx,perch.vy
 perch.vx=ivx+psx perch.vy=ivy+psy
 if total<kinetic(a,R,g)+kinetic(b,R,g) then
  local lo,hi=0,1
  for _=1,20 do
   local al=(lo+hi)/2
   perch.vx=ivx+psx*al perch.vy=ivy+psy*al
   if total<kinetic(a,R,g)+kinetic(b,R,g) then hi=al else lo=al end
  end
  perch.vx=ivx+psx*lo perch.vy=ivy+psy*lo
 end
 return rn
end
local function resolveBalls(a,b,rest)
 if a.z>0 or a.vz>0 or b.z>0 or b.vz>0 then return resolveBalls3D(a,b,rest) end
 rest=rest or C.BallRestitution
 local ox,oy=b.x-a.x,b.y-a.y
 local d=math.sqrt(ox*ox+oy*oy)
 if d<1e-12 then return 0 end
 local nx,ny=ox/d,oy/d
 local rn=(a.vx-b.vx)*nx+(a.vy-b.vy)*ny
 if rn<=0 then return 0 end
 local ni=(1+rest)*rn/2
 a.vx=a.vx-ni*nx a.vy=a.vy-ni*ny
 b.vx=b.vx+ni*nx b.vy=b.vy+ni*ny
 local fx,fy=frictionImpulse(a.vx-b.vx,a.vy-b.vy,a.wx+b.wx,a.wy+b.wy,a.wz+b.wz,nx,ny,ni)
 if fx~=0 or fy~=0 then
  local R=C.R
  local ux,uy=-ny*fx,nx*fx
  a.vx=a.vx+ux a.vy=a.vy+uy b.vx=b.vx-ux b.vy=b.vy-uy
  local wx=2.5*ny*fy/R
  local wy=-2.5*nx*fy/R
  local wz=2.5*fx/R
  a.wx=a.wx+wx a.wy=a.wy+wy a.wz=a.wz+wz
  b.wx=b.wx+wx b.wy=b.wy+wy b.wz=b.wz+wz
 end
 return rn
end
local function capturePockets(state)
 local R,g=C.R,C.Gravity
 local minTip=math.rad(C.PocketTipMinDegrees)
 for _,b in ipairs(state.balls) do
  if not b.pocketed then
   if b.z>0 or b.vz>0 then
    if b.z<C.CushionHeight then
     local p=openingAt(state.geometry,b.x,b.y)
     if p then b.pocketed=true b.falling=true b.pocket=p.id b.wz=0 b.wx=0 b.wy=0 end
    end
   else
    local p=pocketAt(state.geometry,b.x,b.y)
    if p then
     b.pocketed=true b.falling=true b.pocket=p.id b.wz=0
     local ox,oy=b.x-p.x,b.y-p.y
     local d=math.sqrt(ox*ox+oy*oy)
     local depth=(p.radius-d)/R
     if d>1e-6 and depth<1 then
      local dx,dy=ox/d,oy/d
      local ix,iy=-dx,-dy
      local ta=math.max(math.asin(depth),minTip)
      local is=math.max(b.vx*ix+b.vy*iy,0)
      local as=is/(R*math.cos(ta))
      if R*as*as<g*math.cos(ta) then
       b.vx=b.vx-is*ix b.vy=b.vy-is*iy
       b.tip={px=p.x+dx*p.radius,py=p.y+dy*p.radius,nx=ix,ny=iy,theta=ta,omega=as}
      else b.wx=0 b.wy=0 end
     else b.wx=0 b.wy=0 end
    end
   end
  end
 end
end
local function goesOver(g,x,y,z,vx,vy)
 local R=C.R
 if not openingAt(g,x,y) then
  if not containsCenter(g,x,y,R) then return true end
  if z>=C.CushionHeight then
   for _,s in ipairs(g.segments) do
    local d=(x-s.ax)*s.nx+(y-s.ay)*s.ny
    if d<R and -R<d and vx*s.nx+vy*s.ny<0 then
     local sx,sy=s.bx-s.ax,s.by-s.ay
     local p=((x-s.ax)*sx+(y-s.ay)*sy)/(sx*sx+sy*sy)
     if p>=0 and p<=1 then return true end
    end
   end
   for _,p in ipairs(g.points) do
    local ox,oy=x-p.x,y-p.y
    local cr=R+p.radius
    if ox*ox+oy*oy<cr*cr and ox*vx+oy*vy<0 then return true end
   end
  end
 end
 return false
end
local function checkOffTable(state)
 for _,b in ipairs(state.balls) do
  if isAirborne(b) and goesOver(state.geometry,b.x,b.y,b.z,b.vx,b.vy) then leaveTable(b) end
 end
end
local function findEarliestHit(state,maxT,ignored,checkAir)
 local R=C.R
 local g=state.geometry
 local balls=state.balls
 local n=#balls
 local et,eh=maxT,nil
 for i=1,n do
  local a=balls[i]
  if not (a.pocketed or (ignored and ignored[a])) then
   local aAir=checkAir and isAirborne(a)
   local aMov=a.vx~=0 or a.vy~=0 or aAir
   local sr=math.sqrt(a.vx*a.vx+a.vy*a.vy)*maxT+R
   local near=math.abs(a.x)+sr>=g.halfLength or math.abs(a.y)+sr>=g.halfWidth
   if aMov and near and a.z<C.CushionHeight then
    for _,s in ipairs(g.segments) do
     local t=segmentTOI(a.x,a.y,a.vx,a.vy,R,s,et)
     if t and t<et then et=t eh={kind="rail",t=t,a=a,nx=s.nx,ny=s.ny,seg=s} end
    end
    for _,p in ipairs(g.points) do
     local t,nx,ny=pointTOI(a.x,a.y,a.vx,a.vy,R,p.x,p.y,p.radius,et)
     if t and t<et then et=t eh={kind="point",t=t,a=a,nx=nx,ny=ny} end
    end
   end
   for j=i+1,n do
    local b=balls[j]
    if not b.pocketed and not (ignored and ignored[b]) then
     local bAir=checkAir and isAirborne(b)
     local bMov=b.vx~=0 or b.vy~=0 or bAir
     if aMov or bMov then
      local t
      if aAir or bAir then t=sphereTOI(a.x,a.y,a.z,a.vx,a.vy,a.vz,b.x,b.y,b.z,b.vx,b.vy,b.vz,R,et)
      else t=circleTOI(a.x,a.y,a.vx,a.vy,b.x,b.y,b.vx,b.vy,R,et) end
      if t and t<et then et=t eh={kind="ball",t=t,a=a,b=b,nx=0,ny=0} end
     end
    end
   end
  end
 end
 return eh
end
local function pushOut(hit)
 local R,slop=C.R,C.ContactSlop
 local a=hit.a
 if hit.kind=="rail" and hit.seg then
  local s=hit.seg
  local d=(a.x-s.ax)*s.nx+(a.y-s.ay)*s.ny
  if d<R+slop then a.x=a.x+(R+slop-d)*s.nx a.y=a.y+(R+slop-d)*s.ny end
 elseif hit.kind=="ball" and hit.b and (isAirborne(a) or isAirborne(hit.b)) then
  local b=hit.b
  local ox,oy,oz=b.x-a.x,b.y-a.y,b.z-a.z
  local d=math.sqrt(ox*ox+oy*oy+oz*oz)
  local md=2*R+slop
  if d>1e-12 and d<md then
   local aA,bA=isAirborne(a),isAirborne(b)
   local nx,ny,nz=ox/d,oy/d,oz/d
   local share
   if not aA then share=0 elseif bA then share=0.5 else share=1 end
   local corr=md-d
   local function move(x,dir,sh)
    if sh<=0 then return end
    local pz=x.z
    x.x=x.x+dir*nx*corr*sh x.y=x.y+dir*ny*corr*sh
    x.z=math.max(0,x.z+dir*nz*corr*sh)
    local hc=x.z-pz
    if hc<=0 then return end
    local ke=0.5*(x.vx*x.vx+x.vy*x.vy+x.vz*x.vz)
    if ke>0 then
     local sc=math.sqrt(math.max(0,ke-C.Gravity*hc)/ke)
     x.vx=x.vx*sc x.vy=x.vy*sc x.vz=x.vz*sc
    end
   end
   move(a,-1,share)
   move(b,1,1-share)
  end
 elseif hit.kind=="ball" and hit.b then
  local b=hit.b
  local ox,oy=b.x-a.x,b.y-a.y
  local d=math.sqrt(ox*ox+oy*oy)
  local md=2*R+slop
  if d>1e-12 and d<md then
   local corr=(md-d)/2
   local nx,ny=ox/d,oy/d
   a.x=a.x-nx*corr a.y=a.y-ny*corr b.x=b.x+nx*corr b.y=b.y+ny*corr
  end
 end
end
local function layFlat(flyer,other,group)
 local R,g=C.R,C.Gravity
 local ox,oy,oz=other.x-flyer.x,other.y-flyer.y,other.z-flyer.z
 local hd=math.sqrt(ox*ox+oy*oy)
 local nx,ny=1,0
 if hd>1e-12 then nx=ox/hd ny=oy/hd end
 local md=2*R+C.ContactSlop
 if hd<md then flyer.x=flyer.x-nx*(md-hd) flyer.y=flyer.y-ny*(md-hd) end
 local ge=0
 for _,b in ipairs(group) do ge=ge+kinetic(b,R,g) end
 local vd=math.sqrt(math.max(4*R*R-oz*oz,1e-12))
 return {flyer=flyer,group=group,nx=nx,ny=ny,tilt=-oz/vd,vx=flyer.vx,vy=flyer.vy,energy=ge}
end
local function liftFlyer(f)
 local R,g=C.R,C.Gravity
 local fl=f.flyer
 local rs=(f.vx-fl.vx)*f.nx+(f.vy-fl.vy)*f.ny
 if rs<=0 then return end
 fl.vz=fl.vz+f.tilt*rs
 if fl.z<=0 and fl.vz<0 then fl.vz=0 end
 local ke,pe=0,0
 for _,b in ipairs(f.group) do
  local te=kinetic(b,R,g)
  local ve=0.5*b.vz*b.vz+g*b.z
  ke=ke+te-ve pe=pe+ve
 end
 if ke>0 and ke+pe>f.energy then
  local sc=math.sqrt(math.max(0,f.energy-pe)/ke)
  for _,b in ipairs(f.group) do b.vx=b.vx*sc b.vy=b.vy*sc b.wx=b.wx*sc b.wy=b.wy*sc b.wz=b.wz*sc end
 end
end
local function noteHit(state,a,b)
 if state.first then return end
 if a.id==0 then state.first=b.id state.contact={x=a.x,y=a.y}
 elseif b.id==0 then state.first=a.id state.contact={x=b.x,y=b.y} end
end
local advance
advance=function(state,dt,ignored,allowClusters)
 local instant={}
 local remaining=dt
 local count=0
 while remaining>1e-9 and count<C.MaxEventsPerStep do
  count=count+1
  local stepTime=remaining
  local checkAir=false
  for _,b in ipairs(state.balls) do
   if not b.pocketed and (b.z>0 or b.vz>0) then
    if not ignored or not ignored[b] then stepTime=math.min(remaining,C.AirStepSeconds) checkAir=true break end
   end
   stepTime=remaining
  end
  local hit=findEarliestHit(state,stepTime,ignored,checkAir)
  if hit then stepTime=hit.t end
  for _,b in ipairs(state.balls) do
   if not ignored or not ignored[b] then integrateBall(b,stepTime,state.geometry) end
  end
  state.time=state.time+stepTime
  local unused=remaining-stepTime
  capturePockets(state)
  if checkAir then checkOffTable(state) end
  if not hit or hit.a.pocketed or (hit.b and hit.b.pocketed) then
   remaining=unused
  else
   local b=hit.b
   local flyer=nil
   if b and isAirborne(hit.a)~=isAirborne(b) then
    if isAirborne(hit.a) then flyer=hit.a else flyer=b end
   end
   local cluster=nil
   if allowClusters and hit.kind=="ball" and b and (not isAirborne(hit.a) or not isAirborne(b)) then
    local same=flyer==nil
    local within=(not same) and math.abs(hit.a.z-b.z)<=C.SoftContactMaxHopInches
    if (same or within) and clusterTouches(state.balls,hit.a,b,ignored) then
     cluster=clusterGather(state.balls,hit.a,b,state.geometry,ignored,flyer)
    end
   end
   if cluster and b then
    local flat=nil
    if flyer then
     local other=b
     if flyer~=hit.a then other=hit.a end
     flat=layFlat(flyer,other,cluster)
    end
    local ox,oy=b.x-hit.a.x,b.y-hit.a.y
    local d=math.sqrt(ox*ox+oy*oy)
    local imp=0
    if d>1e-12 then imp=((hit.a.vx-b.vx)*ox+(hit.a.vy-b.vy)*oy)/d end
    if imp>0 then noteHit(state,hit.a,b) end
    local dur=resolveContacts(cluster,hit.a,b)
    if flat then liftFlyer(flat) end
    local ign={}
    for _,x in ipairs(cluster) do ign[x]=true end
    advance(state,dur,ign,false)
    unused=unused-dur
   else
    pushOut(hit)
    if hit.kind=="ball" and b then
     if resolveBalls(hit.a,b)>0 then noteHit(state,hit.a,b) end
    else
     local inc=-(hit.a.vx*hit.nx+hit.a.vy*hit.ny)
     resolveRail(hit.a,hit.nx,hit.ny,railRestitution(inc),C.RailFriction)
    end
   end
   remaining=unused
   if hit.t<=C.InstantHitSeconds then
    local c=(instant[hit.a] or 0)+1
    instant[hit.a]=c
    if C.MaxInstantHits<=c then stopBall(hit.a) if b then stopBall(b) end end
   end
   if C.MaxEventsPerStep<=count then stopBall(hit.a) if b then stopBall(b) end end
  end
 end
