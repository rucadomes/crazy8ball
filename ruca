local function firstContact(balls,ox,oy,dx,dy,excluded,pockets)
 local R=C.R
 local best,hitId=1e6,nil
 local found=false
 if pockets then
  for _,p in ipairs(GEO.pockets) do
   local t=pointTOI(ox,oy,dx,dy,0,p.x,p.y,p.radius,best)
   if t and t<best then best=t hitId=nil found=true end
  end
 end
 for _,b in ipairs(balls) do
  if b.id~=0 and b.id~=excluded then
   local t=circleTOI(ox,oy,dx,dy,b.x,b.y,0,0,R,best)
   if t and t<best then best=t hitId=b.id found=true end
  end
 end
 for _,s in ipairs(GEO.segments) do
  local t=segmentTOI(ox,oy,dx,dy,R,s,best)
  if t and t<best then best=t hitId=nil found=true end
 end
 for _,p in ipairs(GEO.points) do
  local t=pointTOI(ox,oy,dx,dy,R,p.x,p.y,p.radius,best)
  if t and t<best then best=t hitId=nil found=true end
 end
 if not found then return nil end
