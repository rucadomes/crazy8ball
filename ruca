 local ok,res,why=pcall(function()
  local t=part.Transparency
  if finite(t) and t>0.99 then return nil,"cue hidden" end
  local s,cf,p=part.Size,part.CFrame,part.Position
  if not s or not cf or not p then return nil,"cue unreadable" end
  local axis
  if s.X>=s.Y and s.X>=s.Z then axis=cf.RightVector elseif s.Y>=s.Z then axis=cf.UpVector else axis=cf.LookVector end
  local ax=(axis.X*F.rx+axis.Z*F.rz)
  local ay=(axis.X*F.lx+axis.Z*F.lz)*mirrorY()
  local al=math.sqrt(ax*ax+ay*ay)
  if al<0.3 then return nil,"cue vertical" end
  ax,ay=ax/al,ay/al
  local px,py=toGame(p)
  local flip=(cue.x-px)*ax+(cue.y-py)*ay<0
  if flip then ax,ay=-ax,-ay end
  local len=math.max(s.X,s.Y,s.Z)
  local gap=nil
  if len>5.5 and len<8.5 then
   local k=flip and -1 or 1
   local tx,ty,tz=p.X+axis.X*k*len/2,p.Y+axis.Y*k*len/2,p.Z+axis.Z*k*len/2
   local cw=world(cue.x,cue.y)
   local d=math.sqrt((tx-cw.X)^2+(ty-cw.Y)^2+(tz-cw.Z)^2)
   gap=d-1.215*STUDS_PER_INCH
  end
  return V(ax,ay),gap
 end)
 if not ok then return nil,tostring(res) end
 return res,why
end

