local lastDump=0
function H.Dump(reason)
 local rows={"Lucky 8 helper diagnostics","version="..H.Version,"reason="..tostring(reason or "manual"),string.format("clock=%.1f",tick())}
 local keys={}
 for k in pairs(H.Stats) do keys[#keys+1]=k end
 table.sort(keys)
 for _,k in ipairs(keys) do rows[#rows+1]=k.."="..tostring(H.Stats[k]) end
 local function path(i) local t={} while i and i~=game do table.insert(t,1,i.Name) i=i.Parent end return table.concat(t,".") end
 local function dumpTree(root)
  if not root then return end
  local list={root}
  for _,d in ipairs(root:GetDescendants()) do list[#list+1]=d end
  for _,d in ipairs(list) do
   local s=path(d).." ["..d.ClassName.."]"
   pcall(function() local v=d.Text if type(v)=="string" then s=s.." text="..v end end)
   pcall(function() local a,z=d.AbsolutePosition,d.AbsoluteSize if a and z then s=s..string.format(" abs=%.0f,%.0f size=%.0f,%.0f",a.X,a.Y,z.X,z.Y) end end)
   pcall(function() local z=d.Size if z and z.X and type(z.X)=="number" then s=s..string.format(" part=%.3f,%.3f,%.3f",z.X,z.Y,z.Z) end end)
   rows[#rows+1]=s
   if #rows>1200 then break end
  end
 end
 local cv=workspace:FindFirstChild("ClientVisuals")
 local hud=bound.hud
 pcall(dumpTree,hud and hud:FindFirstChild("SpinSelector"))
 pcall(dumpTree,hud and hud:FindFirstChild("PowerBar"))
 pcall(dumpTree,cv and cv:FindFirstChild("CueStick"))
 pcall(dumpTree,cv and cv:FindFirstChild("Guideline"))
 pcall(function()
  local g=getgc({"elevation","spin","angle","power"})
  for i=1,math.min(#g,80) do
   local e=g[i]
   rows[#rows+1]=string.format("gc %s=%s (%s)",tostring(e.key),tostring(e.value),tostring(e.type))
  end
 end)
 local ok,err=pcall(writefile,"lucky8_diag.txt",table.concat(rows,"\n"))
 H.Stats.lastDump=ok and "lucky8_diag.txt" or ("dump failed: "..tostring(err))
 pcall(notify,ok and "Saved lucky8_diag.txt" or ("Dump failed: "..tostring(err)),"Pool helper",4)
 return ok
end
local function autoDump(reason)
 if tick()-lastDump<15 then return end
 lastDump=tick() H.Dump(reason)
end

