local function sanePoint(x,y)
 return finite(x) and finite(y) and x>-F.vw and x<F.vw*2 and y>-F.vh and y<F.vh*2
end
local function toScreen(p)
 local s,visible=WorldToScreen(world(p.x,p.y))
 if visible and s and sanePoint(s.X,s.Y) then return s.X,s.Y end
 return nil
end
local function drawLine(line,seg,color)
 local ax,ay=toScreen(seg.a)
 if not ax then return false end
 local bx,by=toScreen(seg.b)
 if not bx then return false end
 line.Color=color line.From=Vector2.new(ax,ay) line.To=Vector2.new(bx,by) show(line)
 return true
end
local function project(ball)
 local x,y=toScreen(ball.p)
 if not x then return nil end
 local qx,qy=toScreen(add(ball.p,V(ball.r,0)))
 if not qx then return nil end
 local radius=math.sqrt((qx-x)^2+(qy-y)^2)
 if not finite(radius) then return nil end
 return Vector2.new(x,y),clamp(radius,1,400)
end
local function drawCircle(circle,ball,color)
 local p,radius=project(ball)
 if not p then return false end
 circle.Position=p circle.Radius=math.max(3,radius) circle.Color=color show(circle)
 return true
end
local function drawBadge(drawing,ball,message,color)
 local p,radius=project(ball)
 if not p then return false end
 radius=math.max(5,radius+3)
 if color then drawing.ring.Color=color drawing.text.Color=color end
 drawing.ring.Position=p drawing.ring.Radius=radius show(drawing.ring)
 drawing.text.Position=Vector2.new(p.X,p.Y-radius-20)
 drawing.text.Text=message show(drawing.text)
 return true
end

local KEY_X,KEY_O,KEY_SPACE,KEY_F7,KEY_G=Enum.KeyCode.X.Value,Enum.KeyCode.O.Value,Enum.KeyCode.Space.Value,Enum.KeyCode.F7.Value,Enum.KeyCode.H.Value
local GROUPS={"Unknown","Solid","Stripe"}
local held={}
local removeAt=nil
local function handleKey(key)
 if held[key] then return end
 held[key]=true
 if key==KEY_X then H.Enabled=not H.Enabled
 elseif key==KEY_SPACE then H.ShowCollisions=not H.ShowCollisions
 elseif key==KEY_F7 then H.Dump("F7")
 elseif key==KEY_G then
  local i=1
  for n,g in ipairs(GROUPS) do if g==H.Group then i=n end end
  H.Group=GROUPS[i%#GROUPS+1]
 elseif key==KEY_O then removeAt=tick()+REMOVE_HOLD end
end
local function releaseKey(key)
 held[key]=nil
 if key==KEY_O then removeAt=nil end
end
local VK={[0x58]=KEY_X,[0x4F]=KEY_O,[0x20]=KEY_SPACE,[0x76]=KEY_F7,[0x48]=KEY_G}
task.spawn(function()
 local was={}
 while H.Running do
  for vk,key in pairs(VK) do
   local ok,down=pcall(iskeypressed,vk)
   down=ok and down==true
   if down and not was[vk] then pcall(handleKey,key) end
   if not down and was[vk] then pcall(releaseKey,key) end
   was[vk]=down
  end
  task.wait(0.03)
 end
end)

local lastLabel=nil
local function setLabel(text)
 if #text>LABEL_MAX then text=text:sub(1,LABEL_MAX-3).."..." end
 if text~=lastLabel then label.Text=text lastLabel=text end
end
local function instantLines(input)
 local white=nil
 for _,b in ipairs(input.balls) do if b.id==0 then white=b break end end
 if not white then return nil end
 local dx,dy=input.dir.x,input.dir.y
 local d,target=firstContact(input.balls,white.x,white.y,dx,dy)
 if not d then return nil end
 local gx,gy=white.x+dx*d,white.y+dy*d
 local out={cue={a=V(white.x,white.y),b=V(gx,gy)},ghost=V(gx,gy),target=target}
 local obj=nil
 if target then for _,b in ipairs(input.balls) do if b.id==target then obj=b end end end
 if obj then
  local ox,oy=obj.x-gx,obj.y-gy
  local ol=math.sqrt(ox*ox+oy*oy)
  if ol>1e-9 then ox,oy=ox/ol,oy/ol end
  local od=firstContact(input.balls,obj.x+ox*0.001,obj.y+oy*0.001,ox,oy,target,true)
  if od then out.object={a=V(obj.x,obj.y),b=V(obj.x+ox*od,obj.y+oy*od)} end
  local sh=dx*ox+dy*oy
  local cx,cy=dx-sh*ox,dy-sh*oy
  local cl=math.sqrt(cx*cx+cy*cy)
  if cl>=0.001 then
   cx,cy=cx/cl,cy/cl
   local cd=firstContact(input.balls,gx+cx*0.001,gy+cy*0.001,cx,cy,target,true)
   if cd then out.after={a=V(gx,gy),b=V(gx+cx*cd,gy+cy*cd)} end
  end
 end
 return out
end
local function isFresh(p,l)
 if not p or not l or p.ballsKey~=l.ballsKey or p.shotKey~=l.shotKey then return false end
 local d=math.abs(p.angle-l.angle)
 if d>math.pi then d=2*math.pi-d end
 return d<0.0035
end
local function render()
 snapshot()
 H.CurrentInput=latest
 local mainCount,extraCount=0,0
 local ready=eightIsReady(currentBalls,ownGroup)
 local nine=ownGroup=="NineBall"
 local lowest=nine and lowestBall(currentBalls) or nil
 local eightRisk=not nine and not ready
 local fresh=H.Enabled and isFresh(preview,latest)
 if fresh then
  H.Stats.previewStatus="Ready"
  local guide,actual=preview.guide,preview.actual
  local live={}
  for _,ball in ipairs(currentBalls) do live[ball.id]=ball end
  local primary=guide.firstContact
  local eightDanger=primary==8 and eightRisk
  local nineFoul=nine and primary~=nil and lowest~=nil and primary~=lowest
  local mainColor=(eightDanger or nineFoul) and red or yellow
  local function mainLine(s)
   if mainCount<#lines then mainCount=mainCount+1 drawLine(lines[mainCount],s,mainColor) end
  end
  local cueGuide=guide.byId[0]
  if cueGuide then for _,s in ipairs(cueGuide.paths) do if not s.afterContact then mainLine(s) end end end
  local target=primary and guide.byId[primary]
  if target then for _,s in ipairs(target.paths) do mainLine(s) end end
  if guide.contact and not eightDanger and not nineFoul then drawCircle(ghost,{p=guide.contact,r=C.R},yellow) end
  local white=actual.byId[0]
  if white and white.pocketed and live[0] then drawBadge(warningDrawings.white,live[0],"WARNING") end
  local eight=actual.byId[8]
  if eight and eight.pocketed and eightRisk and live[8] then drawBadge(warningDrawings.eight,live[8],"WARNING") end
  for _,ball in ipairs(currentBalls) do
   local predicted=actual.byId[ball.id]
   if ball.id~=0 and predicted and predicted.pocketed and pocketDrawings[ball.id] then
    if safePocket(actual,ball.id,ownGroup,ready,lowest) then drawBadge(pocketDrawings[ball.id],ball,"SAFE",green)
    elseif ballSide(ball.id,ownGroup,ready)=="Opponent" then drawBadge(pocketDrawings[ball.id],ball,"!",cyan) end
   end
  end
  for _,ball in ipairs(actual.balls) do
   if markers[ball.id+1] and not ball.offTable and showBallPreview(ball,primary,H.ShowCollisions,not eightRisk) then
    drawCircle(markers[ball.id+1],ball,markerColor(ball,primary,ownGroup,ready,H.ShowCollisions))
   end
  end
  for _,ball in ipairs(actual.balls) do
   if ball.id~=0 and ball.moved and ball.id~=primary and (H.ShowCollisions or (ball.id==8 and eightRisk)) then
    local color=pathColor(ball.id,ownGroup,ready)
    for _,s in ipairs(ball.paths) do
     if extraCount>=#extraLines then break end
     extraCount=extraCount+1
     drawLine(extraLines[extraCount],s,color)
    end
   end
  end
 end
 if H.Enabled and latest and not fresh then
  local g=instantLines(latest)
  if g then
   local target=g.target
   local danger=(target==8 and eightRisk) or (nine and target and lowest and target~=lowest)
   local col=danger and red or yellow
   drawLine(lines[1],g.cue,col)
   if g.object then drawLine(lines[2],g.object,col) end
   if g.after then drawLine(lines[3],g.after,whiteColor) end
   if target and not danger then drawCircle(ghost,{p=g.ghost,r=C.R},yellow) end
   H.Stats.previewStatus="Aiming"
  end
 end
 endFrame()
 local text
 if H.Waiting then text="Waiting for pool table... | Hold O: remove"
 elseif not H.Enabled then text="Preview paused | X resume | Hold O: remove"
 else
  local used=latest and math.floor(latest.power*100+0.5) or nil
  text="Power "..tostring(used or "?").."%"..(H.Stats.powerMode=="max" and " (max)" or "").." ["..tostring(H.Stats.powerSource).."] | Aim: "..tostring(H.Stats.aimSource).." | Elev "..tostring(H.Stats.elevation or 4)
  text=text..string.format(" | Spin %.2f,%.2f",H.Stats.spinX or 0,H.Stats.spinY or 0)..(H.Stats.spinSource~="dot" and " ["..tostring(H.Stats.spinSource).."]" or "")
  text=text.." | Group: "..ownGroup.." (H)"
  text=text.." | SPACE extra "..(H.ShowCollisions and "ON" or "OFF").." | X toggle | Hold O: remove"
  if nine then text=text.." | 9-Ball: hit "..(lowest and tostring(lowest) or "?").." first" end
 end
 if H.Stats.simulationError then text=text.." | Sim: "..H.Stats.simulationError
 elseif H.Stats.bindError then text=text.." | Bind: "..H.Stats.bindError
 elseif H.Enabled and not H.Waiting and H.Stats.previewStatus~="Ready" then text=text.." | "..tostring(H.Stats.previewStatus) end
 setLabel(text)
end
