local function buildTable()
 local g={halfLength=C.HalfLength,halfWidth=C.HalfWidth,pocketsOpen=true,segments={},points={},pockets={}}
 local hl,hw=g.halfLength,g.halfWidth
 local cm=C.CornerMouth/1.4142135623730951
 local sm=C.SideMouth/2
 local ca=math.rad(C.CornerFacingDegrees)
 local sa=math.rad(C.SideFacingDegrees)
 local cs=C.CornerShelf/1.4142135623730951
 local cpr=C.CornerPocketRadius
 local shx,shy=-cm-cs,-cs
 local proj=shx*math.cos(ca)+shy*math.sin(ca)
 local cfl=-proj-math.sqrt(proj*proj-(shx*shx+shy*shy-cpr*cpr))
 local function seg(ax,ay,bx,by,nx,ny) g.segments[#g.segments+1]={ax=ax,ay=ay,bx=bx,by=by,nx=nx,ny=ny} end
 local function pt(x,y,r) g.points[#g.points+1]={x=x,y=y,radius=r} end
 local function facing(x,y,dx,dy,nx,ny,len)
  len=len or C.FacingLength
  local ex,ey=x+dx*len,y+dy*len
  seg(x,y,ex,ey,nx,ny)
  pt(x,y,0)
  pt(ex,ey,C.JawRadius)
 end
 for _,side in ipairs({1,-1}) do
  seg(-hl+cm,side*hw,-sm,side*hw,0,-side)
  seg(sm,side*hw,hl-cm,side*hw,0,-side)
  facing(-sm,side*hw,-math.sin(sa),side*math.cos(sa),math.cos(sa),side*math.sin(sa))
  facing(sm,side*hw,math.sin(sa),side*math.cos(sa),-math.cos(sa),side*math.sin(sa))
  for _,dir in ipairs({1,-1}) do
   facing(dir*(hl-cm),side*hw,dir*math.cos(ca),side*math.sin(ca),dir*math.sin(ca),-side*math.cos(ca),cfl)
  end
 end
 for _,side in ipairs({1,-1}) do
  seg(side*hl,-hw+cm,side*hl,hw-cm,-side,0)
  for _,dir in ipairs({1,-1}) do
   facing(side*hl,dir*(hw-cm),side*math.sin(ca),dir*math.cos(ca),-side*math.cos(ca),dir*math.sin(ca),cfl)
  end
 end
 local px,py=hl+cs,hw+cs
 local spr=C.SidePocketRadius
 g.pockets={
  {id=1,x=-px,y=py,radius=cpr},{id=2,x=0,y=hw+C.SidePocketInset,radius=spr},{id=3,x=px,y=py,radius=cpr},
  {id=4,x=px,y=-py,radius=cpr},{id=5,x=0,y=-hw-C.SidePocketInset,radius=spr},{id=6,x=-px,y=-py,radius=cpr}
 }
 return g
end
